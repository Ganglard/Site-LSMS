# Variables d'environnement LSMS (à copier dans .env.local et dans Vercel)
# Ne jamais committer le .env.local réel.

# OAuth Discord (obligatoire pour /candidature)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://VOTRE-URL.vercel.app/api/auth/discord/callback
NEXT_PUBLIC_DISCORD_CLIENT_ID=same_as_DISCORD_CLIENT_ID
NEXT_PUBLIC_DISCORD_REDIRECT_URI=same_as_DISCORD_REDIRECT_URI

# Optionnel : ajout automatique au serveur Discord après autorisation
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Relais vers le bot Modmail LSMS — candidatures (VM Google Cloud, funnel :8443)
MODMAIL_API_THREAD_URL=https://lspa-bot.tail14ac04.ts.net:8443/api/thread
RELAY_KEY=

# Prise de rendez-vous médical : elle se fait uniquement dans Discord, via le
# bot ModMail dédié (le patient écrit « !rdv » au bot ou clique sur le bouton
# d'un panneau publié par le personnel). Le site ne porte donc AUCUN formulaire
# ni relais HTTP pour les rendez-vous.
#
# Lien « Rendez-vous » du site (nav, footer, bouton d'accueil) : il n'apparaît
# que si cette variable contient l'invitation Discord du serveur LSMS.
# Exemple : NEXT_PUBLIC_LSMS_RDV_DISCORD=https://discord.gg/xxxxxxxx
NEXT_PUBLIC_LSMS_RDV_DISCORD=
