# LSMS — variables d'environnement (a copier dans .env.local ET dans Vercel)
# NE JAMAIS committer le .env.local reel.

# --- OAuth Discord (obligatoire pour /candidature) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://VOTRE-URL.vercel.app/api/auth/discord/callback
NEXT_PUBLIC_DISCORD_CLIENT_ID=same_as_DISCORD_CLIENT_ID
NEXT_PUBLIC_DISCORD_REDIRECT_URI=same_as_DISCORD_REDIRECT_URI

# Optionnels (auto-add au serveur Discord apres autorisation, via bot)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# --- Relais bot ModMail (quand le bot LSMS existera) ---
# MODMAIL_API_THREAD_URL=https://.../api/thread
# RELAY_KEY=
